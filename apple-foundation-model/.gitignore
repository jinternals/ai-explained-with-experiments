# Swift Package Manager build output
.build/
.swiftpm/

# The built app, build/Foundation Model Server.app, is committed. The signing files that
# scripts/build-app.sh writes next to it when given a provisioning profile are not.
build/profile.plist
build/entitlements.plist

# Xcode, if the package is opened there
DerivedData/
xcuserdata/
*.xcuserstate

# Signing material: never commit provisioning profiles or private keys
*.provisionprofile
*.mobileprovision
*.p12
*.cer

# Local environment and editor files
.env
.env.*
.DS_Store
.vscode/
.idea/
*.swp
